{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // Pi supplies these peers to extensions, including linked dependencies.
    "paths": {
      "@earendil-works/*": ["./node_modules/@earendil-works/*"],
      "typebox": ["./node_modules/typebox"]
    },
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": [
    "src/**/*",
    "extensions/**/*",
    "examples/**/*",
    "scripts/**/*",
    "tests/**/*"
  ],
  // tests/evals has its own tsconfig: it depends on the gitignored vendored
  // pi-evals harness, so `pnpm typecheck` must stay green without a sync.
  "exclude": ["node_modules", "tests/evals"]
}
